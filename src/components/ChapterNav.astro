---
import { nextChapter, prevChapter } from '../data/chapters'
import { url } from '../lib/url'

interface Props {
  slug: string
}
const { slug } = Astro.props
const prev = prevChapter(slug)
const next = nextChapter(slug)
---
<nav
  class="max-w-5xl mx-auto px-6 mt-20 pt-8 border-t border-surveillance/10 dark:border-cream/10 flex justify-between items-stretch gap-3 sm:gap-6"
  aria-label="Chapter navigation"
>
  {
    prev ? (
      <a href={url(prev.slug)} class="group flex items-center gap-2 min-w-0 flex-1 py-2 text-surveillance/70 dark:text-cream/70 hover:text-[#a7422f] dark:hover:text-[#ea917b] transition-colors">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        <span class="text-left">
          <span class="block font-mono text-[10px] uppercase tracking-widest opacity-60">Previous</span>
          <span class="font-display font-bold break-words">{prev.title}</span>
        </span>
      </a>
    ) : (
      <a href={url()} class="group flex items-center gap-2 min-w-0 flex-1 py-2 text-surveillance/70 dark:text-cream/70 hover:text-[#a7422f] dark:hover:text-[#ea917b] transition-colors">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        <span class="font-display font-bold">Home</span>
      </a>
    )
  }
  {
    next && (
      <a href={url(next.slug)} class="group flex items-center gap-2 min-w-0 flex-1 py-2 text-[#a7422f] dark:text-[#ea917b] font-bold hover:text-surveillance dark:hover:text-cream transition-colors text-right justify-end">
        <span>
          <span class="block font-mono text-[10px] uppercase tracking-widest opacity-60">Next</span>
          <span class="font-display font-bold break-words">{next.title}</span>
        </span>
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    )
  }
</nav>
