---
import { cities, cityOrder, ratio, AFFORDABLE_CUTOFF } from '../data/cities'
import { source } from '../data/citations'
import { asset } from '../lib/url'

// Source figures are already rounded in Demographia. No underlying price/income
// pairs are published in the cited table; do not fabricate them for a bar chart.
const payload = cityOrder.map((k) => {
  const c = cities[k]
  return {
    key: c.key,
    name: c.name,
    market: c.market,
    desc: c.desc,
    narrative: c.narrative,
    currency: c.currency,
    ratio: ratio(c),
    ownershipDataYear: c.ownershipDataYear,
    ownershipEditionYear: c.ownershipEditionYear,
    incomeType: c.incomeType,
    ownershipSourceLocation: c.ownershipSourceLocation,
    ownershipSourceUrl: source(c.ownershipSourceId)?.url ?? '',
    burden: c.burden
      ? {
          ...c.burden,
          sourceUrl: source(c.burden.sourceId)?.url ?? '',
        }
      : null,
    image: { src: asset(c.image.src), alt: c.image.alt },
  }
})
const first = payload[0]
const chartMax = Math.max(...payload.map((c) => c.ratio))
---

<section class="max-w-7xl mx-auto px-6 py-10" data-city-explorer>
  <div class="grid grid-cols-1 lg:grid-cols-12 border border-surveillance/20 dark:border-cream/10 surface shadow-sm">
    <div class="lg:col-span-4 border-b lg:border-b-0 lg:border-r border-surveillance/20 dark:border-cream/10 flex flex-col">
      <div class="p-6 border-b border-surveillance/20 dark:border-cream/10 bg-blueprint">
        <span class="font-mono text-[10px] uppercase text-surveillance/60 dark:text-cream/50 mb-1 block">Select metropolitan market</span>
        <h3 class="font-display font-bold text-2xl">The Markets</h3>
      </div>
      <div class="flex-grow flex flex-col" role="tablist" aria-label="Housing markets">
        {
          payload.map((c, i) => (
            <button
              data-city-btn={c.key}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              class="w-full text-left px-4 py-4 border-b border-surveillance/10 dark:border-cream/10 flex justify-between items-center hover:bg-surveillance/5 dark:hover:bg-cream/5 transition-all pl-4"
            >
              <span class="font-mono text-sm uppercase tracking-widest text-surveillance/70 dark:text-cream/70" data-city-label>
                {c.name}
              </span>
              <span class="material-symbols-outlined text-sm text-rust hidden" data-city-arrow aria-hidden="true">arrow_right</span>
            </button>
          ))
        }
      </div>
      <div class="p-8 mt-auto surface-muted">
        <div class="font-mono text-[10px] uppercase text-rust mb-2 tracking-widest">System note · interpretation</div>
        <p class="font-body text-lg italic leading-relaxed text-surveillance/80 dark:text-cream/80" data-city-narrative>{first.narrative}</p>
      </div>
    </div>

    <div class="lg:col-span-8 relative flex flex-col">
      <div class="flex justify-between items-start p-6 gap-4 flex-wrap">
        <div>
          <span class="font-mono text-[10px] uppercase text-surveillance/50 dark:text-cream/50 block mb-1">Metropolitan housing market</span>
          <span class="font-display font-bold text-2xl uppercase" data-city-title>{first.name}</span>
          <span class="font-mono text-xs text-rust uppercase tracking-widest block mt-1" data-city-desc>{first.desc}</span>
        </div>
      </div>

      <div class="relative h-48 bg-surveillance overflow-hidden mx-6">
        <div class="absolute inset-0 bg-blueprint opacity-20 z-10 mix-blend-overlay"></div>
        <img data-city-img src={first.image.src} alt={first.image.alt} class="absolute inset-0 w-full h-full object-cover opacity-60 grayscale contrast-125 mix-blend-luminosity transition-all duration-700" />
      </div>

      <div class="p-6 md:p-8">
        <span class="font-mono text-[10px] uppercase text-surveillance/60 dark:text-cream/50 block mb-2">Median house-price / gross household-income multiple</span>
        <div class="flex items-baseline gap-2">
          <span class="font-display font-bold text-6xl text-rust" data-city-ratio>{first.ratio.toFixed(1)}</span>
          <span class="font-mono text-sm text-surveillance/50 dark:text-cream/50">x</span>
        </div>

        <figure class="mt-8" aria-label="House-price-to-household-income multiple compared with the source's affordable category cutoff">
          <div class="h-6 bg-surveillance/10 dark:bg-cream/10 relative overflow-visible">
            <div class="h-full bg-rust transition-all duration-500" data-city-ratio-bar style={`width:${(first.ratio / chartMax) * 100}%`}></div>
            <div class="absolute top-0 bottom-0 border-l-2 border-dashed border-soft-green" style={`left:${(AFFORDABLE_CUTOFF / chartMax) * 100}%`} aria-hidden="true"></div>
          </div>
          <figcaption class="font-mono text-[10px] text-surveillance/60 dark:text-cream/60 mt-2">
            Dashed mark: Demographia “affordable” category cutoff (≤ 3.0x); same scale across markets
          </figcaption>
        </figure>

        <p class="mt-6 font-mono text-xs text-surveillance/70 dark:text-cream/70" data-city-burden hidden></p>
        <p class="mt-4 font-mono text-[10px] text-surveillance/60 dark:text-cream/60" data-city-metadata></p>
      </div>
    </div>
  </div>
  <p class="mt-3 font-mono text-xs text-surveillance/70 dark:text-cream/70" data-city-sources>
    <a data-city-ownership-source href={first.ownershipSourceUrl} target="_blank" rel="noopener noreferrer" class="text-rust underline underline-offset-2">Ownership source (2025 edition, 2024 Q3 data)</a>
    <span data-city-source-location>{first.ownershipSourceLocation}</span>
    <a data-city-burden-source href="#" target="_blank" rel="noopener noreferrer" class="text-rust underline underline-offset-2" hidden>Burden source</a>
  </p>
  <script type="application/json" data-city-data set:html={JSON.stringify(payload)}></script>
</section>

<script>
  const root = document.querySelector('[data-city-explorer]')
  if (root) {
    const data = JSON.parse(root.querySelector('[data-city-data]')?.textContent || '[]')
    const maxRatio = Math.max(...data.map((d) => d.ratio))
    const q = (sel) => root.querySelector(sel)

    function select(key) {
      const c = data.find((d) => d.key === key)
      if (!c) return
      q('[data-city-narrative]').textContent = c.narrative
      q('[data-city-title]').textContent = c.name
      q('[data-city-desc]').textContent = c.desc
      q('[data-city-ratio]').textContent = Number(c.ratio).toFixed(1)
      q('[data-city-ratio-bar]').style.width = `${(c.ratio / maxRatio) * 100}%`
      q('[data-city-metadata]').textContent =
        `${c.market} · 2024 Q3 data (published in ${c.ownershipEditionYear}) · ${c.incomeType}; prices and incomes in ${c.currency}, ratio is unitless. Underlying monetary pairs are not published in the cited source table.`
      const burden = q('[data-city-burden]')
      burden.hidden = !c.burden
      if (c.burden) burden.textContent = `${c.burden.label}: ${c.burden.value} (${c.burden.year}). ${c.burden.definition}`
      q('[data-city-ownership-source]').href = c.ownershipSourceUrl
      q('[data-city-source-location]').textContent = ` · ${c.ownershipSourceLocation}`
      const burdenSource = q('[data-city-burden-source]')
      burdenSource.hidden = !c.burden
      if (c.burden) {
        burdenSource.href = c.burden.sourceUrl
        burdenSource.textContent = ` · Burden source (${c.burden.year}): ${c.burden.sourceLocation}`
      }
      const img = q('[data-city-img]')
      img.src = c.image.src
      img.alt = c.image.alt
      root.querySelectorAll('[data-city-btn]').forEach((btn) => {
        const active = btn.getAttribute('data-city-btn') === key
        btn.classList.toggle('bg-surveillance/5', active)
        btn.classList.toggle('dark:bg-cream/5', active)
        btn.classList.toggle('border-l-4', active)
        btn.classList.toggle('border-l-rust', active)
        btn.setAttribute('aria-selected', String(active))
        const label = btn.querySelector('[data-city-label]')
        label?.classList.toggle('text-rust', active)
        label?.classList.toggle('font-bold', active)
        btn.querySelector('[data-city-arrow]')?.classList.toggle('hidden', !active)
      })
    }

    root.querySelectorAll('[data-city-btn]').forEach((btn) => {
      btn.addEventListener('click', () => select(btn.getAttribute('data-city-btn')))
    })
    if (data.length) select(data[0].key)
  }
</script>
