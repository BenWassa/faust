---
// Self-complexity as a resilience diagram: consolidated (brittle) vs diversified.
const consolidated = ['Work']
const diversified = ['Work', 'Family', 'Craft', 'Friends', 'Community', 'Practice']
---
<div class="surface p-8 md:p-10 my-12 not-prose">
  <div class="flex items-baseline justify-between mb-8">
    <h3 class="font-display font-bold text-2xl">Where identity is stored</h3>
    <span class="font-mono text-[10px] uppercase tracking-widest text-surveillance/70 dark:text-cream/70">Fig 06.1</span>
  </div>
  <div class="grid md:grid-cols-2 gap-8">
    <div>
      <span class="font-mono text-[10px] uppercase tracking-widest text-surveillance/70 dark:text-cream/70 block mb-3">Consolidated — brittle</span>
      <ul class="flex flex-wrap gap-2 mb-3" aria-label="Consolidated roles">
        {consolidated.map((r) => (
          <li class="px-4 py-3 bg-rust text-white font-mono text-xs uppercase tracking-widest w-full text-center">{r}</li>
        ))}
      </ul>
      <p class="font-body text-sm text-surveillance/70 dark:text-cream/70">One room holds everything. A single flood takes the house — a layoff becomes an identity collapse.</p>
    </div>
    <div>
      <span class="font-mono text-[10px] uppercase tracking-widest text-soft-green block mb-3">Diversified — resilient</span>
      <ul class="grid grid-cols-2 gap-2 mb-3" aria-label="Diversified roles">
        {diversified.map((r) => (
          <li class="px-3 py-2 border border-surveillance/20 dark:border-cream/20 font-mono text-[10px] uppercase tracking-widest text-center">{r}</li>
        ))}
      </ul>
      <p class="font-body text-sm text-surveillance/70 dark:text-cream/70">Load spread across many domains. Any one can fail without the self going with it.</p>
    </div>
  </div>
</div>
