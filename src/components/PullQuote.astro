---
interface Props {
  cite?: string
}
const { cite } = Astro.props
---
<figure class="my-12 border-l-4 border-rust pl-8 py-2 not-prose">
  <blockquote class="font-display font-bold text-2xl md:text-3xl text-surveillance dark:text-cream italic leading-snug">
    <slot />
  </blockquote>
  {cite && <figcaption class="block mt-4 font-mono text-sm text-rust uppercase tracking-widest">— {cite}</figcaption>}
</figure>
