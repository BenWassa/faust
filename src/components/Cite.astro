---
import { source } from '../data/citations'
interface Props {
  id: string
}
const { id } = Astro.props
const s = source(id)
const label = s ? (s.short ?? s.author.split(' ').slice(-1)[0]) : ''
---
{
  s && (
    <sup class="font-mono text-[10px] text-[#a7422f] dark:text-[#ea917b] align-super break-words" style="overflow-wrap: anywhere">
      {s.url ? (
        <a class="!text-[#a7422f] dark:!text-[#ea917b]" href={s.url} target="_blank" rel="noopener noreferrer" title={`${s.author}, ${s.title} (${s.year})`}>
          [{label} {s.year}]
        </a>
      ) : (
        <span title={`${s.author}, ${s.title} (${s.year})`}>
          [{label} {s.year}]
        </span>
      )}
    </sup>
  )
}
