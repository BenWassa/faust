---
import { navChapters } from '../data/chapters'
import { url } from '../lib/url'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  active?: string
  progress?: number
}
const { active = '', progress = 0 } = Astro.props
---

<nav
  id="navbar"
  aria-label="Primary navigation"
  class="fixed top-0 left-0 w-full z-50 bg-cream/95 dark:bg-ink-900/95 backdrop-blur-sm border-b border-surveillance/10 dark:border-cream/10 transition-all duration-300 py-3"
>
  <div
    id="progress-bar"
    aria-hidden="true"
    class="h-1 bg-rust absolute top-0 left-0 transition-all duration-500"
    style={`width: ${progress}%`}
  ></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex justify-between items-center gap-3">
    <a href={url()} class="flex items-center gap-3 shrink-0 min-h-11" aria-label="Project Faust — home">
      <span class="material-symbols-outlined text-[#a7422f] dark:text-[#ea917b]" aria-hidden="true">grid_4x4</span>
      <span class="font-display font-bold text-base md:text-lg tracking-tight uppercase hidden sm:block">Architecture of Ambition</span>
    </a>

    <div class="hidden xl:flex items-center gap-4 xl:gap-6 font-mono text-xs uppercase tracking-widest text-surveillance/70 dark:text-cream/70">
      {
        navChapters.map((c) => (
          <a
            href={url(c.slug)}
            aria-current={active === c.slug ? 'page' : undefined}
            class:list={[
              'hover:text-[#a7422f] dark:hover:text-[#ea917b] transition-colors py-3',
              active === c.slug && 'text-[#a7422f] dark:text-[#ea917b] font-bold',
            ]}
          >
            {c.title}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3 shrink-0">
      <a
        href={url('diagnostic')}
        class="hidden sm:inline-flex items-center min-h-11 font-mono text-xs uppercase tracking-widest bg-surveillance text-cream dark:bg-[#a7422f] px-3 py-2 hover:bg-rust transition-colors"
        >Diagnose</a
      >
      <ThemeToggle />
      <button
        type="button"
        class="xl:hidden text-surveillance dark:text-cream min-w-11 min-h-11 inline-flex items-center justify-center"
        id="mobile-menu-btn"
        aria-label="Open navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined" data-mobile-menu-icon aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden xl:hidden border-t border-surveillance/10 dark:border-cream/10 bg-cream dark:bg-ink-900 px-6 py-4 flex-col gap-1 max-h-[calc(100dvh-4rem)] overflow-y-auto"
  >
    {
      navChapters.map((c) => (
        <a
          href={url(c.slug)}
          aria-current={active === c.slug ? 'page' : undefined}
          class="font-display text-lg hover:text-[#a7422f] dark:hover:text-[#ea917b] flex items-center gap-3 min-h-11 py-2"
        >
          <span class="font-mono text-xs text-[#a7422f] dark:text-[#ea917b]">{c.num}</span>
          {c.title}
        </a>
      ))
    }
    <a
      href={url('diagnostic')}
      class="font-mono text-sm uppercase tracking-widest bg-surveillance text-cream dark:bg-[#a7422f] px-4 py-3 text-center mt-2 min-h-11"
      >Take the Diagnostic</a
    >
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  const icon = btn?.querySelector('[data-mobile-menu-icon]')
  const setMenuOpen = (open: boolean) => {
    if (!btn || !menu) return
    menu.classList.toggle('hidden', !open)
    menu.classList.toggle('flex', open)
    btn.setAttribute('aria-expanded', String(open))
    btn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu')
    if (icon) icon.textContent = open ? 'close' : 'menu'
  }
  btn?.addEventListener('click', () => {
    setMenuOpen(btn.getAttribute('aria-expanded') !== 'true')
  })
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false)
      btn.focus()
    }
  })
  document.addEventListener('pointerdown', (event) => {
    if (btn?.getAttribute('aria-expanded') === 'true' && !document.getElementById('navbar')?.contains(event.target as Node)) {
      setMenuOpen(false)
    }
  })
  const desktop = window.matchMedia('(min-width: 1280px)')
  desktop.addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false)
  })

  // A subtle reading affordance without layout changes.
  const nav = document.getElementById('navbar')
  const onScroll = () => {
    if (!nav) return
    nav.classList.toggle('shadow-md', window.scrollY > 40)
  }
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()
</script>
